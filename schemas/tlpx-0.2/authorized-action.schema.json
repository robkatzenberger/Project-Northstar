{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-layer.local/schemas/tlpx-0.2/authorized-action.schema.json",
  "title": "TL-PX 0.2 Authorized Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requesting_principal",
    "executing_principal",
    "action",
    "target",
    "arguments",
    "environment",
    "tenant",
    "derived_risk",
    "effective_risk",
    "data_classes",
    "capability",
    "resource_scope",
    "payload_hash",
    "artifact_hash",
    "policy_bundle_hash",
    "adapter"
  ],
  "properties": {
    "requesting_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "executing_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "action": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "arguments": { "type": "object" },
    "environment": { "type": "string", "minLength": 1 },
    "tenant": { "type": "string", "minLength": 1 },
    "derived_risk": { "$ref": "common.schema.json#/$defs/risk" },
    "effective_risk": { "$ref": "common.schema.json#/$defs/risk" },
    "risk_reasons": { "type": "array", "items": { "type": "string" } },
    "data_classes": { "type": "array", "items": { "type": "string" } },
    "capability": { "type": "string", "minLength": 1 },
    "resource_scope": { "type": "array", "items": { "type": "string" } },
    "payload_hash": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/hashString" }, { "type": "null" }]
    },
    "artifact_hash": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/hashString" }, { "type": "null" }]
    },
    "policy_bundle_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "adapter": { "$ref": "common.schema.json#/$defs/adapter" }
  }
}
