{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-layer.local/schemas/tlpx-0.2/execution.schema.json",
  "title": "TL-PX 0.2 Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "standard",
    "standard_version",
    "execution_id",
    "claim_id",
    "authorization_id",
    "receipt_id",
    "requesting_principal",
    "executing_principal",
    "intent_hash",
    "authorized_action_hash",
    "executed_action_hash",
    "target",
    "policy_bundle_id",
    "policy_bundle_version",
    "policy_bundle_hash",
    "adapter",
    "adapter_principal",
    "adapter_binary_hash",
    "sequence",
    "started_at",
    "ended_at",
    "state",
    "result_summary",
    "result_hash",
    "external_evidence_reference",
    "cancellation_outcome"
  ],
  "properties": {
    "record_type": { "const": "tlpx.execution" },
    "standard": { "const": "TL-PX" },
    "standard_version": { "const": "0.2.0" },
    "execution_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "authorization_id": { "type": "string", "minLength": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "requesting_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "executing_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "intent_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "authorized_action_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "executed_action_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "target": { "type": "string", "minLength": 1 },
    "policy_bundle_id": { "type": "string", "minLength": 1 },
    "policy_bundle_version": { "type": "string", "minLength": 1 },
    "policy_bundle_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "adapter": { "$ref": "common.schema.json#/$defs/adapter" },
    "adapter_principal": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/principalId" }, { "type": "null" }]
    },
    "adapter_binary_hash": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/hashString" }, { "type": "null" }]
    },
    "sequence": { "$ref": "common.schema.json#/$defs/sequence" },
    "started_at": { "$ref": "common.schema.json#/$defs/isoTime" },
    "ended_at": { "$ref": "common.schema.json#/$defs/isoTime" },
    "state": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "LEASE_EXPIRED",
        "COMPLETED_CONFIRMED",
        "FAILED_CONFIRMED",
        "OUTCOME_UNKNOWN_FINAL"
      ]
    },
    "result_summary": { "type": ["string", "null"], "maxLength": 2048 },
    "result_hash": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/hashString" }, { "type": "null" }]
    },
    "external_evidence_reference": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2048
    },
    "cancellation_outcome": {
      "enum": [
        null,
        "CANCELLED_BEFORE_SIDE_EFFECT",
        "CANCELLATION_REQUESTED",
        "CANCELLED_DURING_EXECUTION",
        "CANCELLATION_UNSUPPORTED",
        "COMPLETED_BEFORE_CANCELLATION"
      ]
    }
  },
  "anyOf": [
    { "properties": { "result_summary": { "type": "string", "minLength": 1 } } },
    { "properties": { "result_hash": { "$ref": "common.schema.json#/$defs/hashString" } } },
    { "properties": { "external_evidence_reference": { "type": "string", "minLength": 1 } } }
  ]
}
