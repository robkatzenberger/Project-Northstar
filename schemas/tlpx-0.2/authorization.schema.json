{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-layer.local/schemas/tlpx-0.2/authorization.schema.json",
  "title": "TL-PX 0.2 Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "standard",
    "standard_version",
    "authorization_id",
    "receipt_id",
    "requesting_principal",
    "executing_principal",
    "action",
    "target",
    "authorized_action_hash",
    "action_binding_hash",
    "intent_hash",
    "environment",
    "tenant",
    "adapter",
    "issued_at",
    "claim_expires_at",
    "execution_lease_seconds",
    "authorization_nonce",
    "idempotency_key",
    "state"
  ],
  "properties": {
    "record_type": { "const": "tlpx.authorization" },
    "standard": { "const": "TL-PX" },
    "standard_version": { "const": "0.2.0" },
    "authorization_id": { "type": "string", "minLength": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "requesting_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "executing_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "action": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "authorized_action_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "action_binding_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "intent_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "environment": { "type": "string", "minLength": 1 },
    "tenant": { "type": "string", "minLength": 1 },
    "adapter": { "$ref": "common.schema.json#/$defs/adapter" },
    "issued_at": { "$ref": "common.schema.json#/$defs/isoTime" },
    "claim_expires_at": { "$ref": "common.schema.json#/$defs/isoTime" },
    "execution_lease_seconds": { "type": "integer", "minimum": 1 },
    "authorization_nonce": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "state": { "const": "AUTHORIZED_UNCLAIMED" }
  }
}
