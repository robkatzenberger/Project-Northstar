{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trust-layer.local/schemas/tlpx-0.2/authorization-claim.schema.json",
  "title": "TL-PX 0.2 Authorization Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "standard",
    "standard_version",
    "claim_id",
    "authorization_id",
    "receipt_id",
    "executing_principal",
    "authorized_action_hash",
    "action_binding_hash",
    "executed_action_hash",
    "adapter",
    "claimed_at",
    "lease_expires_at",
    "sequence",
    "state"
  ],
  "properties": {
    "record_type": { "const": "tlpx.authorization_claim" },
    "standard": { "const": "TL-PX" },
    "standard_version": { "const": "0.2.0" },
    "claim_id": { "type": "string", "minLength": 1 },
    "authorization_id": { "type": "string", "minLength": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "executing_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "authorized_action_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "action_binding_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "executed_action_hash": { "$ref": "common.schema.json#/$defs/hashString" },
    "adapter": { "$ref": "common.schema.json#/$defs/adapter" },
    "claimed_at": { "$ref": "common.schema.json#/$defs/isoTime" },
    "lease_expires_at": { "$ref": "common.schema.json#/$defs/isoTime" },
    "sequence": { "$ref": "common.schema.json#/$defs/sequence" },
    "state": { "const": "CLAIMED" }
  }
}
